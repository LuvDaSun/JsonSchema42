{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "typescript",
      "tsconfig": "tsconfig.json",
      "option": "watch",
      "problemMatcher": ["$tsc-watch"],
      "label": "tsc-watch",
      "group": "build"
    },
    {
      "type": "shell",
      "command": "./node_modules/.bin/rollup --config rollup.config.mjs --waitForBundleInput --no-watch.clearScreen --watch",
      "isBackground": true,
      "label": "rollup-watch",
      "group": "build",
      "problemMatcher": [
        {
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*",
            "endsPattern": "waiting\\s+for\\s+"
          },
          "pattern": [
            {
              "regexp": "^$",
              "file": 0,
              "line": 0,
              "column": 0,
              "code": 0,
              "message": 0
            }
          ]
        }
      ],
      "dependsOn": ["tsc-watch"]
    },
    {
      "dependsOn": ["tsc-watch", "rollup-watch"],
      "label": "build-watch",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
